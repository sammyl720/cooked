# Required for live Jev evaluation. Without it, the app labels and uses deterministic demo scoring.
TYPESAFE_API_KEY=

# Required for screenshot text extraction.
OPENAI_API_KEY=
OCR_MODEL=gpt-6-astra

# Required in production. Generate long, random, independent values.
CHALLENGE_SIGNING_SECRET=
RATE_LIMIT_SALT=

# Optional monetization. Billing stays off unless this switch, live Jev, and all Stripe values are present.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BILLING_FREE_READS=3
BILLING_PACK_CREDITS=25
BILLING_PRICE_DISPLAY=$4.99
STRIPE_AUTOMATIC_TAX=false
